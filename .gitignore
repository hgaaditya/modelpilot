# Everything below is fetched/generated by start.ps1 - not committed.

# vendored open-webui source (downloaded from its GitHub release tag; version is in the dir name,
# _old-* is the previous version parked by `-Action upgrade`)
/open-webui-*/
/_old-open-webui-*/

# which versions are actually installed (written by start.ps1 after each successful run)
/.stack-versions.json

# downloaded binaries
/llama.cpp/
# config.yaml is generated from config.example.yaml on first deploy, with {{LOCALLLM_ROOT}}
# replaced by wherever the repo was cloned - so it holds absolute paths and a per-machine
# model list, and only the template is tracked.
/llamaswap/*
!/llamaswap/config.example.yaml

# model weights
*.gguf

# runtime logs
/logs/

# editor/session cruft
/.claude/
__pycache__/
*.pyc

# hardware/crash investigation output - diagnose.ps1's reports, and whatever monitoring tool
# was pointed at the box during a stability hunt
/diag-*.txt
/GPU-Z Sensor Log.txt

# benchmark output (timestamped runs, regenerable)
/bench/results/

# per-machine answer to "may the python grader run model-written code" - consent doesn't travel
/bench/.code-exec-consent

# PrismML llama.cpp fork (downloaded by -Action install-prism, ~1.2 GB of binaries)
/llama.cpp-prism/

# llmfit binary (downloaded by -Action install-llmfit)
/llmfit/

# uv, plus the private CPython it installs and its download cache. Kept inside the install rather
# than machine-wide so nothing is left behind on uninstall.
/uv/
/.python/
/.uv-cache/

# per-machine panel state (paths, ports, which services you run) - not shareable
/.ui-settings.json
/.ui-usage.json

# which models have been shown to actually work with Claude Code - depends on this machine's
# llama.cpp build and the models installed, so it doesn't travel
/.agent-compat.json

# ComfyUI: multi-GB weights and a venv, provisioned by -Action install-comfy.
comfyui/
