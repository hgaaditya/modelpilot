# Everything below is fetched/generated by start.ps1 - not committed.

# vendored open-webui source (downloaded from its GitHub release tag; version is in the dir name,
# _old-* is the previous version parked by `-Action upgrade`)
/open-webui-*/
/_old-open-webui-*/

# which versions are actually installed (written by start.ps1 after each successful run)
/.stack-versions.json

# downloaded binaries
/llama.cpp/
/llamaswap/*
!/llamaswap/config.yaml

# model weights
*.gguf

# runtime logs
/logs/

# editor/session cruft
/.claude/

# benchmark output (timestamped runs, regenerable)
/bench/results/

# PrismML llama.cpp fork (downloaded by -Action install-prism, ~1.2 GB of binaries)
/llama.cpp-prism/

# per-machine panel state (paths, ports, which services you run) - not shareable
/.ui-settings.json
/.ui-usage.json
